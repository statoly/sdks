{
  "name": "@statoly/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript client for the Statoly API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statoly/sdks.git",
    "directory": "typescript"
  },
  "homepage": "https://statoly.ch",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
