  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@microsoft/kiota-abstractions": "1.0.0-preview.108",
    "@microsoft/kiota-bundle": "1.0.0-preview.108"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "@microsoft/kiota-abstractions": "1.0.0-preview.108"
  }
